# Salin menjadi .env lalu jalankan: npm run start:env  (Node >= 20.6)
# PORT=3000
# Isi data contoh dari soal (Q3) saat server start
# SEED=true

# --- Automation (scripts/) ---
# API_URL=http://localhost:3000
SNAPSHOT_DIR=./snapshots
RETENTION_DAYS=30
# 08:00, 12:00, 15:00 WIB (timezone dipaksa Asia/Jakarta di scheduler.js)
SNAPSHOT_CRON=0 8,12,15 * * *
# Cleanup harian pukul 00:30 WIB
CLEANUP_CRON=30 0 * * *

# --- Database Configuration (untuk mode npm run prod / db) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=subscriber_db
SEED=false
PORT=4000
API_URL=http://localhost:4000